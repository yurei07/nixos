# Nothing OS style shell for Hyprland: Quickshell panel (bar, control center,
# dock, OSD, power menu), Nothing brand fonts, wallpapers and swaync/rofi skins.
# The panel itself is vendored from the `nothing-panel` input.
{
  inputs,
  lib,
  pkgs,
  ...
}:
{
  home.file.".config/quickshell/nothing".source = "${inputs."nothing-panel"}/shell";
  home.file.".local/share/fonts/Nothing".source = ./fonts;
  home.file."Pictures/wallpapers/nothing".source = ./wallpaper;
  home.file.".config/swaync/style.css".source = ./swaync/style.css;
  home.file.".config/swaync/config.json".source = ./swaync/config.json;
  home.file.".config/rofi/nothing.rasi".source = ./rofi/nothing.rasi;
  home.file.".config/rofi/nothing-grid.rasi".source = ./rofi/nothing-grid.rasi;
  home.file.".config/nothing".source = ./scripts;
  home.file.".config/hypr/hyprlock.conf".source = ./hyprlock.conf;

  home.packages = with pkgs; [
    awww
    rofi
    swaynotificationcenter
    slurp
    adw-gtk3
    adwaita-fonts
    gnome-control-center
    hyprsunset
    hyprlock
    bibata-cursors
  ];

  dconf.settings = {
    "org/gnome/desktop/interface" = {
      gtk-theme = "adw-gtk3-dark";
      font-name = "Adwaita Sans 11";
      monospace-font-name = "Lettera Mono LL 11";
      cursor-theme = "Bibata-Modern-Ice";
      icon-theme = "Nothing-Mono"; # generated by nothing-mono-icons.py
    };
  };
}
