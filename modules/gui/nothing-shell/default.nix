# Nothing OS style for Hyprland: the Quickshell shell (bar, control center, dock,
# desktop widgets, OSD, power menu, glyph lights) vendored from
# https://github.com/uzayr-iqbal-hamid/nothing-os-dots-hyprland (MIT),
# plus Nothing brand fonts (community packaging: xeji01/nothingfont).
# The shell starts via Hyprland autostart: `qs -c nothing`.
# Notifications: swaync, skinned with the same palette (right side, Lettera Mono).
{
  lib,
  pkgs,
  ...
}:
{
  # The Quickshell shell itself (read-only symlink into the Nix store).
  home.file.".config/quickshell/nothing".source = ./shell;

  # Nothing brand fonts: Ndot 57 (dot-matrix), NType 82 (widget serif),
  # Lettera Mono LL (UI labels).
  home.file.".local/share/fonts/Nothing".source = ./fonts;

  # Wallpapers (grainy geometric set) + the apply script.
  home.file."Pictures/wallpapers/nothing".source = ./wallpaper;

  # swaync: notification daemon + control panel, Nothing style.
  home.file.".config/swaync/style.css".source = ./swaync/style.css;
  home.file.".config/swaync/config.json".source = ./swaync/config.json;

  # rofi app grid themes.
  home.file.".config/rofi/nothing.rasi".source = ./rofi/nothing.rasi;
  home.file.".config/rofi/nothing-grid.rasi".source = ./rofi/nothing-grid.rasi;

  home.packages = with pkgs; [
    awww # wallpaper daemon (swww renamed upstream)
    rofi # app grid (Super+D)
    swaynotificationcenter # swaync: notifications
    slurp # region select for the screen recorder
    adw-gtk3 # GTK theme, black surfaces
    adwaita-fonts # "Adwaita Sans" used by the shell QML
  ];

  # GTK / fonts / icons follow the Nothing look as well.
  dconf.settings = {
    "org/gnome/desktop/interface" = {
      gtk-theme = "adw-gtk3-dark";
      font-name = "Adwaita Sans 11";
      monospace-font-name = "Lettera Mono LL 11";
      # Generated by nothing-mono-icons.py from Papirus (see wallpaper/README).
      icon-theme = "Nothing-Mono";
    };
  };
}
